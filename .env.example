# Copy to .env.local (web) / .env (worker). Never commit real values.
# Local Supabase values are printed by `supabase status`.

# --- Web (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Worker (worker/) ---
# Service-role access stays server-side only (never in NEXT_PUBLIC_*).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Providers: mock adapters by default, no real keys in this repo ---
LLM_PROVIDER=mock
PAYMENTS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
